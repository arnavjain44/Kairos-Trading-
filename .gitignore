# ==============================================================================
# Kairos .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# Secrets & Environment Variables
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.pfx

# ------------------------------------------------------------------------------
# Python & Bytecode
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
.venv/
env/
venv/
ENV/
env.bak/
venv.bak/

# Test, Coverage & Caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.ruff_cache/
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# ------------------------------------------------------------------------------
# Frontend & Node.js
# ------------------------------------------------------------------------------
node_modules/
.next/
out/
.pnpm-store/
.yarn/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------------------------
# Databases, Local Storage & Infrastructure
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.db
*.sqlite3-journal
data/
timescale_data/
postgres_data/
redis_data/
dump.rdb
*.rdb
*.aof

# ------------------------------------------------------------------------------
# Market Datasets & Data Artifacts
# ------------------------------------------------------------------------------
# Keep directory placeholders (.gitkeep)
!**/ml/datasets/.gitkeep
!**/ml/notebooks/.gitkeep
ml/datasets/*
!ml/datasets/.gitkeep
*.csv
*.parquet
*.feather
*.h5
*.hdf5

# ------------------------------------------------------------------------------
# Machine Learning Runs, Checkpoints & Artifacts
# ------------------------------------------------------------------------------
mlruns/
.mlflow/
checkpoints/
*.ckpt
*.onnx
*.pkl
*.pickle
*.joblib
*.pt
*.pth
lightning_logs/
wandb/

# ------------------------------------------------------------------------------
# Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
*.pid
*.tmp
*.temp

# ------------------------------------------------------------------------------
# Operating System & IDE
# ------------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
.ipynb_checkpoints/
