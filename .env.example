# ==============================================================================
# Kairos Environment Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this file to create your local .env:
#    PowerShell: Copy-Item .env.example .env
#    Bash:       cp .env.example .env
# 2. Never commit .env into source control (it is excluded by .gitignore).
# 3. For Phase 0, all services run with the default development settings below.
#    Broker credentials and AI API keys are NOT required to build or test Phase 0.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application & Environment
# ------------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
APP_HOST=127.0.0.1
APP_PORT=8000
TIMEZONE=Asia/Kolkata

# ------------------------------------------------------------------------------
# Database & Cache Infrastructure (Local Docker)
# ------------------------------------------------------------------------------
POSTGRES_USER=kairos_user
POSTGRES_PASSWORD=kairos_dev_password
POSTGRES_DB=kairos_db
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ------------------------------------------------------------------------------
# Trading, Capital & Risk Engine Defaults (Phase 0 Constraints)
# ------------------------------------------------------------------------------
TRADING_MODE=paper
STARTING_CAPITAL=10000
RISK_PER_TRADE_PCT=0.01
DAILY_LOSS_LIMIT_PCT=0.015
MAX_OPEN_POSITIONS=2
RISK_PROFILE=moderate

# ------------------------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------------------------
# Controls whether the post-market "Last session review" static export is enabled.
# Keep false by default until verified.
LAST_SESSION_ENABLED=false

# ------------------------------------------------------------------------------
# Market Data Integrations (Optional - Future Phase 1)
# ------------------------------------------------------------------------------
# Used in Phase 1 for historical and live market data. Leave empty in Phase 0.
ANGEL_ONE_API_KEY=
ANGEL_ONE_CLIENT_CODE=
ANGEL_ONE_PASSWORD=
ANGEL_ONE_TOTP_SECRET=

# ------------------------------------------------------------------------------
# AI Gateway LLM Providers (Optional - Future Phase 4)
# ------------------------------------------------------------------------------
# Used in Phase 4 for news summaries and conversational explanations.
# The system fails over in order: Groq -> Cerebras -> Mistral -> Gemini -> OpenRouter.
# Leave empty in Phase 0.
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
